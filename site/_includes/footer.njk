<footer class="site-footer">
  <p>{{ meta.author }} · <a href="{{ meta.orcid_url }}">ORCID {{ meta.orcid }}</a></p>
  {% if meta.zenodo_url %}
  <p>Frozen archive: <a href="{{ meta.zenodo_url }}">doi:{{ meta.zenodo_doi }}</a>. <a href="{{ meta.repo_url }}">Code</a>.</p>
  {% else %}
  <p>Frozen archive forthcoming. <a href="{{ meta.repo_url }}">Code</a>.</p>
  {% endif %}
</footer>
